# Feedstock recipe for hello
# spec 13 §9 + docs/conventions.md in tebako-packages/index
name: "hello"
kind: toolkit
summary: "GNU hello — template prover payload for tebako-packages"

upstream:
  url: "https://ftp.gnu.org/gnu/hello/hello-2.12.tar.gz"
  sha256: "cf04af86dc085268c5f4470fbae49b18afbc221b78096aab842d934a76bad0ab"
  version: "2.12"

build:
  system: autotools        # autotools | cmake | meson
  link_mode: dynamic       # dynamic | wrapped | tfs-native | static
  rpath_origin: true       # $ORIGIN/../lib for dynamic builds
  deps: []                 # other feedstocks: [{name, constraint, mount}]

# Imaging exclusions (spec 13 §9; the spec 03 §5 grammar — payload-root-
# relative globs, a matched directory prunes its subtree, the manifest
# never records the list): host documentation is dead weight inside a
# mounted exec-tier image — the host's man/info never reads it there —
# so it stays out of the shipped payload.
exclude:
  - share/info
  - share/man

# Image tooling (every leg): the tfs CLI from the tamatebako/tebako
# release — `tfs mkimage` (limnifs, the default tebako image format) is
# the imager and the boot smoke's info/tree/extract reader. The asset
# digests are pinned here (the repo's toolchain pin SSOT — the same
# trust-anchor role as upstream.sha256) and cross-checked against the
# release's own SHA256SUMS at fetch time (common.sh's download_tfs).
tools:
  repo: "tamatebako/tebako"
  release: "v2.8.74"
  sha256:
    linux-gnu-x86_64: "607b34099b8aa784d90ade9f4b179b842c39a072799641bb0926cc1810b3839b"
    macos-arm64: "f9928a420d2726a3722639048ff926924855080791d92243ecd1da59f73a27da"
    macos-x86_64: "e03c1dfd57b27f552de641176754d86c042fff1aca0241d077b0b106881f8093"
    windows-ucrt64: "b06ee4975992b5ef3b372662887db6c5ff851651310bb94545a4a8d6bb1b7cba"

# Signing (spec 09 §9 — opt-in per feedstock): on tag pushes tools/publish
# signs every payload image (plus SHA256SUMS and the registry itself) with
# the CI signing subkey of the tamatebako root, supplied as the org secret
# TEBAKO_CI_SIGNING_KEY, and the registry pins the PRIMARY keyid (the
# identity, not the rotating subkey instrument). A declared signing block
# with an absent secret fails the publish — a signing feedstock never
# ships an unsigned release silently. The signer binary is fetched from
# the pinned release and verified against the pinned digest (the same
# trust-anchor role as upstream.sha256).
signing:
  keyid: "efc3c250f7862a48" # 2026-09-09 tamatebako root primary (low 64)
  tool:
    repo: "tamatebako/tebako"
    release: "v2.8.21"
    sha256: "3f78997f1c111729eef9fbe6d017947bc7db0ca2db4b2249312d14d5e6637573" # tebako-pkg-2.8.21-linux-gnu-x86_64

platforms:
  - x86_64-linux-gnu
  # - aarch64-linux-gnu    # optional per feedstock brief; enable when proven
  - aarch64-macos
  - x86_64-macos
  - x86_64-windows-ucrt

provides:
  executables:
    # the windows image carries /bin/hello.exe (stage fills the suffix)
    - {name: "hello", path: "/bin/hello", version: "2.12"}
  libraries: []

exec_tier: dynamic         # from build.link_mode
exec_closure: []           # static tier only
